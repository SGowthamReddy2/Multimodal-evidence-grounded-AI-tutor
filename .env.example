# Groq Cloud API Key for Frontier LLM inference (Qwen 2.5 72B / Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY= your_groq_api_key_here
# Google Gemini API Key for Multimodal VLM (gemini-2.5-flash with 1,000,000 TPM limit)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY = your_gemini_key_here
# ---------------------------------------------------------------------------
# LiteLLM Model Swapping Configuration (Seamless Model Switching)
# ---------------------------------------------------------------------------
# High-Quality Reasoning Model (Config A)
LLM_MODEL_QUALITY=groq/openai/gpt-oss-120b

# High-Speed Reasoning Model (Config B)
LLM_MODEL_SPEED=groq/qwen/qwen3.8-27b

# Automatic Fallback LLM Model if primary encounters rate limit
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# VLM Keyframe & Slide Captioning Configuration
# ---------------------------------------------------------------------------
# Primary Fast VLM API (e.g. groq/qwen/qwen3.8-27b, gemini/gemini-2.5-flash, openai/gpt-4o-mini)
VLM_MODEL_PRIMARY=groq/qwen/qwen3.8-27b
